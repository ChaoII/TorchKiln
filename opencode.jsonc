{
  "$schema": "https://opencode.ai/config.json",
  // 仓库已改名: PytorchOCR → TorchKiln (2026-09-23)。
  // 同事木海仍习惯用旧名 “PytorchOCR” 指代本项目/路径/命令, 以下 instructions 里必须带上对照。
  "instructions": [
    "AGENTS.md"
  ],
  "references": {
    "rename": {
      "path": "AGENTS.md",
      "description": "仓库改名注意点: 旧名 PytorchOCR / pytorchx / ptx 与新名 TorchKiln / torchkiln / tkiln 对照; 木海仍说 PytorchOCR 时按此映射, 勿改 ModelScope URL 与 PYTORCHOCR_* 环境变量"
    },
    "docs": {
      "path": "docs",
      "description": "训练/结构/FAQ/数据格式等详细文档 (STRUCTURE/TRAINING/FAQ/MODEL_ZOO 已含改名说明)"
    }
  },
  "command": {
    "rename-map": {
      "description": "打印 PytorchOCR → TorchKiln 改名对照与不可改项",
      "template": "根据 AGENTS.md 的「仓库改名」章节, 列出: (1) 三层命名旧→新对照; (2) 必须保留禁止改的外部契约 (ModelScope ChaoII0987/PytorchOCR、PYTORCHOCR_* 环境变量、pytorchocr shim、conda 环境 ptocr); (3) 缓存 ~/.torchkiln 与旧 ~/.pytorchocr 回退。用简洁 markdown 表格回答。若用户说「PytorchOCR」或「木海说 PytorchOCR」, 说明那就是本仓库 TorchKiln 的旧名, 路径现为 E:\\TorchKiln, 包 import torchkiln, CLI 用 tkiln / python -m torchkiln。"
    }
  }
}
